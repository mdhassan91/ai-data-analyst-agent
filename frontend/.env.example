# Production setup: the browser calls this app's /api/chat route, which forwards
# to the FastAPI backend on the server, so the token never reaches the browser.
BACKEND_URL=http://YOUR_BACKEND_HOST:8000/chat
BACKEND_API_KEY=change-me

# Optional: call a backend directly from the browser instead (e.g. the n8n
# prototype locally). Leave empty in production.
# NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/data-analyst-agent
# NEXT_PUBLIC_N8N_AUTH_HEADER_NAME=X-API-Key
# NEXT_PUBLIC_N8N_AUTH_TOKEN=change-me
