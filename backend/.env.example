# Postgres connection string. With Supabase, use the IPv4 "Session pooler" string,
# and URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Deliberately not ANTHROPIC_API_KEY, so a stale key elsewhere in the shell
# can't override it (docs/build-report.md, challenge 8).
APP_ANTHROPIC_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Shared secret the frontend sends in the X-API-Key header.
API_AUTH_TOKEN=change-me

# Allowed CORS origin.
FRONTEND_URL=http://localhost:3000
